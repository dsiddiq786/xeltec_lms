# =============================================================================
# brickSkill LMS - Production Environment Variables
# Copy to .env and fill in REAL production values before deploying
# =============================================================================

# ── General ──
NODE_ENV=production

# ── Database (PostgreSQL) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_HERE
POSTGRES_DB=lms_db

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_HERE

# ── JWT (REQUIRED — generate with: openssl rand -hex 32) ──
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ── Stripe (get from https://dashboard.stripe.com/apikeys) ──
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Frontend URL (used for email links, CORS, Stripe redirects) ──
FRONTEND_URL=https://lms.xeltecdev.com
CORS_ORIGIN=https://lms.xeltecdev.com

# ── Email ──
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=noreply@brickskill.com
SENDGRID_API_KEY=SG.xxx

# ── Storage ──
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
# S3_BUCKET=
# S3_REGION=eu-west-1

# ── AI Course Generator (Python FastAPI service) ──
OPENAI_API_KEY=sk-...
MONGODB_URI=mongodb://mongo:27017
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
GENERATED_COURSES_DIR=/app/Generated_Courses
